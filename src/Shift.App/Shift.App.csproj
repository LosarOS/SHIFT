<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <ImplicitUsings>disable</ImplicitUsings>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- The unpackaged WinUI resource loader looks for this well-known main index. -->
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/shift.ico</ApplicationIcon>
    <StartupObject>Shift.App.Program</StartupObject>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <AssemblyName>SHIFT</AssemblyName>
    <RootNamespace>Shift.App</RootNamespace>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- NotifyIcon needs the Forms runtime, not WindowsDesktop's WPF XAML compiler.
         UseWindowsForms imports WinFX targets after WinUI and overrides its compiler. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <ProjectReference Include="../Shift.Infrastructure/Shift.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <!-- Windows App SDK already includes image content. Update metadata instead of adding
         a second PRI resource with the same key (PRI175/PRI277 on Windows publish). -->
    <Content Update="Assets/shift.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Windows App SDK 1.8 uses the legacy MRT targets for unpackaged apps.
       They generate the PRI during Build but do not add it to dotnet publish.
       Publish the generated index, including embedded XBF and merged control resources. -->
  <Target Name="PublishShiftResources" AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_GenerateProjectPriFile">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="WinUI application resource index is missing: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>resources.pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
