root = true
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
[*.{json,yml,yaml}]
indent_size = 2
[*.cs]
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = false
csharp_new_line_before_open_brace = all
[packaging/Smoke-Windows.ps1]
charset = utf-8-bom
